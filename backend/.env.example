# --- HTTP server ---
HTTP_ADDR=:8080
FRONTEND_BASE_URL=http://localhost:3000
DEFAULT_LOCALE=th
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-For. Leave EMPTY
# unless this service sits behind a reverse proxy: empty = trust none, so the
# auth rate limiter buckets on the real client IP instead of a spoofable one.
# Behind Nginx/ELB, set this to that proxy's address(es).
TRUSTED_PROXIES=

# --- Database ---
# Local dev: a Postgres instance running on the same machine.
# Production: point at the real DB host, use a strong password, and use
# sslmode=require (or verify-full) so DB traffic is encrypted.
DATABASE_URL=postgres://filemepls:filemepls@localhost:5432/filemepls?sslmode=disable

# --- JWT session ---
# REQUIRED to be a strong random value in every environment; the app refuses to
# start with this placeholder or anything shorter than 32 bytes. Generate one:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h

# --- Storage ---
STORAGE_ROOT=./data/storage
# MAX_UPLOAD_SIZE in bytes; 0 (or unset) means unlimited. Set a real cap in
# production (e.g. 104857600 for 100MB) — 0 lets a single request fill the disk.
MAX_UPLOAD_SIZE=0
# Comma-separated list of allowed mime types, e.g.
#   image/png,image/jpeg,application/pdf
# "*" allows any mime type — DO NOT use "*" in production; list only the types
# you actually accept so the content-sniff gate can reject everything else.
ALLOWED_MIMES=*

# --- Local Send (LAN file transfer) ---
# false = open LocalSend-style hub (anyone reaching the backend can appear in
# the peer roster). Set true when the backend is exposed beyond a trusted LAN
# so only logged-in users can join.
SEND_REQUIRE_AUTH=false

# --- OAuth: GitHub ---
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# --- OAuth: Google ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
